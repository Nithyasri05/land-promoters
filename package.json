    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.3",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.13",
    "npm": "^10.8.0",
